# Vercel Frontend Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables

# Backend API URL (Railway/Render/etc.)
# If backend and frontend are on SAME domain, leave empty or don't set
# If backend is SEPARATE, set to your backend URL:
VITE_API_URL=https://your-railway-app.up.railway.app

# Example for same-domain deployment (Railway full-stack):
# VITE_API_URL=

# Example for separate backend (Vercel + Railway):
# VITE_API_URL=https://roshan-digital-api.up.railway.app
